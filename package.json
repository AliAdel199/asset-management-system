{
  "name": "asset-management-system",
  "private": true,
  "version": "0.1.0",
  "description": "Government asset management and tracking system.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "build": "npm run build:web && npm run build:api",
    "lint:web": "npm run lint --workspace apps/web",
    "lint:api": "npm run lint --workspace apps/api",
    "lint": "npm run lint:web && npm run lint:api"
  },
  "engines": {
    "node": ">=22"
  }
}
