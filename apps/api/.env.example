DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asset_management_system?schema=public"

# ولّد قيمة عشوائية طويلة خاصة بكل بيئة، ولا تستخدم نفس القيمة بالتطوير والإنتاج.
JWT_SECRET="change-me-to-a-long-random-secret"

# روابط الواجهة المسموح لها بالاتصال بالـ API (CORS)، مفصولة بفاصلة عند تعدد البيئات.
WEB_APP_ORIGINS="http://localhost:3000"

# المنفذ الذي يستمع عليه الـ API (اختياري، الافتراضي 3001).
PORT=3001

# --- متغيرات خاصة بـ prisma/seed.cjs (npm run db:seed) فقط، لا يقرأها التطبيق وقت التشغيل ---

# كلمة مرور مستخدمي البذر (admin, central.user, ...). القيمة الافتراضية إن تُركت فارغة
# معروفة علناً بمستودع الكود - عيّن قيمة عشوائية طويلة بأي بيئة تجريبية أو رسمية.
SEED_USER_PASSWORD=""

# true يُدخل موجودات وطلبات صيانة وهمية للتطوير المحلي فقط. اتركه فارغاً أو false
# بأي بيئة تجريبية أو رسمية حتى لا تختلط بيانات وهمية ببيانات حقيقية.
SEED_DEMO_DATA=""
