{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/jwt$": "<rootDir>/../src/test-mocks/nestjs-jwt.mock.ts",
    "^@nestjs/passport$": "<rootDir>/../src/test-mocks/nestjs-passport.mock.ts"
  }
}
